{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APEX Race Scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "base_run_id",
    "interventions",
    "rollouts"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "base_run_id": {
      "type": "string",
      "minLength": 1
    },
    "rollouts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "risk_measure": {
      "enum": [
        "expected_position",
        "p90_position",
        "expected_race_time",
        "p90_race_time"
      ]
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "car_id"
        ],
        "properties": {
          "type": {
            "enum": [
              "pace_mode",
              "pit",
              "weather",
              "control_scale",
              "flag"
            ]
          },
          "car_id": {
            "type": "string"
          },
          "lap": {
            "type": "integer",
            "minimum": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "value": {},
          "compound": {
            "enum": [
              "SOFT",
              "MEDIUM",
              "HARD",
              "INTERMEDIATE",
              "WET"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
